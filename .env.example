# App
# URL publica da aplicacao. Em producao, use o dominio final da Vercel.
NEXT_PUBLIC_APP_URL=

# Supabase
# URL e anon key podem ir para o navegador. A service role fica somente no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
# Somente servidor. Nunca crie NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# Stripe
# Publishable key pode ir ao navegador. Secret key, webhook secret, prices e cupom ficam no servidor.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO_FIRST_MONTH_29=
STRIPE_COUPON_PRO_FIRST_MONTH_29=

# Resend
# Chave e remetente usados apenas pelo backend para envio do ebook e e-mails transacionais.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Tracking
# IDs publicos opcionais. Se ficarem vazios, GA4 e Meta Pixel nao sao carregados.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Admin
# E-mails autorizados separados por virgula.
ADMIN_EMAILS=

# Kiwify
# Legado/aquisicao. Segredo somente servidor; URLs publicas podem ser usadas em CTAs.
KIWIFY_WEBHOOK_SECRET=
NEXT_PUBLIC_KIWIFY_EBOOK_URL=
NEXT_PUBLIC_KIWIFY_PRO_ORDER_BUMP_URL=
NEXT_PUBLIC_KIWIFY_STARTER_URL=
NEXT_PUBLIC_KIWIFY_PREMIUM_URL=
