# Pode ficar publica. Use a Project URL do Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Pode ficar publica com RLS ativo. Nunca use a service_role key aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL publica usada em callbacks, emails e redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tracking opcional para trafego pago. Se ficarem vazias, nada e carregado no navegador.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe e o billing principal do SaaS.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_COUPON_PRO_FIRST_MONTH_29=
# Alias aceito para o mesmo cupom, se voce preferir este nome.
STRIPE_PRICE_PRO_FIRST_MONTH_29=

# Kiwify fica como funil de aquisicao: ebook, order bump e origem do lead.
NEXT_PUBLIC_KIWIFY_EBOOK_URL=
NEXT_PUBLIC_KIWIFY_PRO_ORDER_BUMP_URL=
NEXT_PUBLIC_KIWIFY_STARTER_URL=
NEXT_PUBLIC_KIWIFY_PREMIUM_URL=

# Somente servidor. Nunca use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# E-mail transacional opcional. Se RESEND_API_KEY ficar vazia, o funil continua funcionando e registra envio como skipped.
RESEND_API_KEY=
EMAIL_FROM=AtendeZap IA <noreply@example.com>

# Admin interno. Separe multiplos e-mails por virgula.
ADMIN_EMAILS=

# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Quando existir, o webhook da Kiwify deve validar este segredo.
KIWIFY_WEBHOOK_SECRET=
