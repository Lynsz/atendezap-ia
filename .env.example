# Pode ficar publica. Use a Project URL do Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# Pode ficar publica com RLS ativo. Nunca use a service_role key aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL publica usada em callbacks, emails e redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Asaas e o billing principal do SaaS. Use sandbox em desenvolvimento.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# Kiwify fica como funil de aquisicao: ebook, order bump e origem do lead.
NEXT_PUBLIC_KIWIFY_EBOOK_URL=
NEXT_PUBLIC_KIWIFY_PRO_ORDER_BUMP_URL=
NEXT_PUBLIC_KIWIFY_STARTER_URL=
NEXT_PUBLIC_KIWIFY_PREMIUM_URL=

# Somente servidor. Nunca use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Quando existir, o webhook da Kiwify deve validar este segredo.
KIWIFY_WEBHOOK_SECRET=
