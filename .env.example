# Pode ir para o navegador. Use a Project URL do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://cnxwomllglzifnewqslu.supabase.co

# Pode ir para o navegador com RLS ativo. Nunca use a service_role key aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URLs publicas de checkout Kiwify. Se ficarem vazias, o app mostra fallback seguro.
NEXT_PUBLIC_KIWI_INITIAL_CHECKOUT_URL=
NEXT_PUBLIC_KIWI_PRO_CHECKOUT_URL=

# Server-side apenas. Nunca use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# SUPABASE_SERVICE_ROLE_KEY nunca deve ser usada no front-end.
